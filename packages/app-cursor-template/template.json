{
  "name": "@sea-lion/app-lab-template",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:aliyun-dev": "tsc && vite build --mode development",
    "build:aliyun-staging": "tsc && vite build --mode staging",
    "build:aliyun-prod": "tsc && vite build --mode production",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives --max-warnings 999",
    "lint-fix": "eslint src --fix --ext .js,.jsx,.ts,.tsx",
    "ls-lint": "ls-lint",
    "postinithook": "husky add .husky/pre-commit \"npx lint-staged\"",
    "inithook": "husky install",
    "postinstall": "husky install",
    "preview": "npm run build:aliyun-prod && vite preview",
    "mock": "json-server --watch mock/db.json"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run ls-lint",
      "npm run lint"
    ]
  },
  "dependencies": {
    "@easycode/client-detector": "^1.3.6",
    "axios": "^1.4.0",
    "classnames": "^2.3.2",
    "js-cookie": "^3.0.5",
    "qs": "^6.11.2",
    "query-string": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^6.4.4",
    "react-router-dom": "^6.13.0",
    "sea-lion-ui": "latest"
  },
  "devDependencies": {
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@ls-lint/ls-lint": "^2.2.3",
    "@types/node": "^20.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-legacy": "^5.4.2",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.38.0",
    "eslint-config-ali": "^15.1.0",
    "husky": "^8.0.3",
    "json-server": "^1.0.0-beta.2",
    "less": "^4.1.3",
    "lint-staged": "^13.2.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-babel-plugin": "^0.0.2",
    "vite-plugin-cdn-import": "^0.3.5"
  }
}
